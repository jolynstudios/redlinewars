# Tool output. capture/baseline/dbgview/profile all write here, and the gates write frozen
# copies of `dist` alongside their PNGs so a measurement cannot be contaminated by a
# concurrent build. None of it is source: every byte is reproducible from a seed plus a
# commit, which is the whole point of §5.2.
#
# Original named .blend files under art/blender/assets/ are editable repository source.
# Runtime packs, captures and portraits below are derived build output.
.artifacts/
web/shots/
/bin-browser/

# Roster/spec export cache — a build product regenerated by the engine utility.
web/.forge/
art/blender/__pycache__/

# Downloaded external art sources (CC0 / CC-BY, pinned by hash in art/sources.lock.json).
# Build input only: never committed, never fetched at runtime. Refill with `npm run art:fetch`.
art/.sources/

# Blender writes a .blend1 rollback beside every save; it is editor state, not source.
*.blend1
.env
.codex/

# Local backup trees and logs: the canonical roster is git itself; backups never.
codex backup/
art/blender/backups/
**/art/blender/backups/
update.log
*.pyc

# spine all-time totals (live in-memory system, no database)
engine/steelseed-host/tools/network-stats.json

# Electron shell: installed toolchain and packaging output.
desktop/node_modules/
desktop/dist/

# Local machine state and scratch: standalone engine builds, personal PDF
# exports, temp files, and editor/agent plans. None of it is source.
engine/bin-standalone/
output/
tmp/
.zcode/
